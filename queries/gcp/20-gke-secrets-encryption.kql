// SHA CLUSTER_SECRETS_ENCRYPTION_DISABLED.
RawEntityMetadata
| where Environment == 'GCP' and Identifiers.Type == 'REPLACE_WITH_GCP_GKE_CLUSTER_TYPE'
| extend EncryptionState = tostring(Record.databaseEncryption.state)
| extend HealthStatus = iff(EncryptionState =~ 'ENCRYPTED', 'HEALTHY', 'UNHEALTHY')
| project Id, Name, Environment, Identifiers, AdditionalData, Record, HealthStatus